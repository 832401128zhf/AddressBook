@model Contact
@{
    ViewData["Title"] = "联系人详情";
}

<h2>📇 联系人详情</h2>
<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title mb-3">
            @Model.Name
            @if (Model.IsFavorite)
            {
                <span class="text-warning">★ 已收藏</span>
            }
        </h4>

        <dl class="row">
            <dt class="col-sm-3">姓名</dt><dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">公司</dt><dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Company) ? "—" : Model.Company)</dd>
            <dt class="col-sm-3">备注</dt><dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Notes) ? "—" : Model.Notes)</dd>
            <dt class="col-sm-3">创建时间</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>

        <h5 class="mt-4">联系方式</h5>
        @if (Model.ContactMethods.Count == 0)
        {
            <p class="text-muted">暂无联系方式。</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr><th>类型</th><th>内容</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.ContactMethods)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@m.Type</span></td>
                            <td>@m.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">编辑</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">删除</a>
        <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
    </div>
</div>
