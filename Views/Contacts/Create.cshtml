@model ContactViewModel
@{
    ViewData["Title"] = "添加联系人";
}

<h2>➕ 添加联系人</h2>
<hr />

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="请输入姓名" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Company" class="form-label"></label>
            <input asp-for="Company" class="form-control" placeholder="公司 / 单位（可选）" />
            <span asp-validation-for="Company" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Notes" class="form-label"></label>
            <input asp-for="Notes" class="form-control" placeholder="备注（可选）" />
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>

    <div class="form-check mt-3">
        <input asp-for="IsFavorite" class="form-check-input" />
        <label asp-for="IsFavorite" class="form-check-label"></label>
    </div>

    <div class="mt-4">
        <label class="form-label fw-bold">联系方式（一个联系人可添加多个：电话 / 邮箱 / 社交账号 / 地址）</label>
        <div id="methodsContainer">
            @for (int i = 0; i < Model.ContactMethods.Count; i++)
            {
                <div class="method-row row g-2 mb-2">
                    <div class="col-md-4">
                        <select name="ContactMethods[@i].Type" class="form-select">
                            @foreach (var t in new[] { "电话", "邮箱", "社交账号", "地址", "其他" })
                            {
                                <option value="@t" selected="@(Model.ContactMethods[i].Type == t)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input name="ContactMethods[@i].Value" value="@Model.ContactMethods[i].Value" class="form-control" placeholder="请输入内容" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-danger w-100" onclick="removeMethodRow(this)">删除</button>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addMethodRow()">＋ 添加联系方式</button>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">保存</button>
        <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/site.js"></script>
}
